#esses dois primeiros é em [Cloudflare] > [projeto e conecte] > [Turnstile] 
# Frontend (Vite)
VITE_TURNSTILE_SITE_KEY=
# Firebase Client (frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# URL pública principal da aplicação (usada por APIs e futura autenticação)
SITE_URL=https://www.mandatotransparente.com.br
# Backend / Vercel Functions
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
SUGESTOES_DEST_EMAIL=
SUGESTOES_FROM_EMAIL=
SUGESTOES_RATE_LIMIT_MAX=5

# Futuro Better Auth / origens confiáveis
# Gere com 32+ caracteres de alta entropia
BETTER_AUTH_SECRET=
# Separe múltiplas origens por vírgula
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,https://www.mandatotransparente.com.br


# Firebase Admin (backend seguro)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa: cole o JSON completo da service account em linha única
FIREBASE_SERVICE_ACCOUNT_JSON=

# Segurança de sessão/auth
AUTH_SESSION_TTL_MS=43200000
AUTH_RATE_LIMIT_MAX=8
PROFILE_RATE_LIMIT_MAX=20

# Google Search Console Verification
# Obtenha em: https://search.google.com/search-console
# Método: Meta tag → copie apenas o valor do content="..."
VITE_GSC_VERIFICATION_TOKEN=
